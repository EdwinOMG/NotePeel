# Google OAuth (for Sign in with Google button)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Backend API URL (REQUIRED for production — must be set at build time)
# Local dev doesn't need this (defaults to http://localhost:8000)
# For Render: set this to your backend service URL, e.g. https://notepeelbackend.onrender.com
VITE_API_URL=
